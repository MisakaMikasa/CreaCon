# Development only. An INSTALLED build has no .env - it reads
# %APPDATA%\CreaCon\config.json, written by the app's settings screen.
# Resolution order is config.json -> environment -> this file.

# Which provider llm_client.py dispatches to: "gemini", "anthropic" or "openai_compat"
LLM_PROVIDER=gemini

GEMINI_API_KEY=...
# Google retires the 2.5 models no earlier than 2026-10-16. Do not pin one.
GEMINI_MODEL=gemini-3.8-flash

# A proxy that speaks Gemini's OWN protocol (e.g. a Cloudflare AI Gateway
# google-ai-studio URL). Leave unset for Google directly.
# GEMINI_BASE_URL=

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# LLM_PROVIDER=openai_compat: OpenRouter or any OpenAI-compatible endpoint.
# Segmentation goes through it too, so no Gemini key is needed. The model must
# be a Gemini one for segmentation to work - other models can't trace masks.
OPENAI_COMPAT_API_KEY=sk-or-...
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_MODEL=google/gemini-3.8-flash
