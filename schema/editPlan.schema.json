{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIEditPlan",
  "type": "object",
  "required": ["summary", "steps"],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "description": "One sentence describing the overall edit, shown to the user before they approve it."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["op", "description", "params"],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "createAdjustmentLayer",
            "updateAdjustmentLayer",
            "renameLayer",
            "setLayerOpacity",
            "createGroup",
            "addMask",
            "setBlendMode",
            "applyCameraRaw"
          ]
        },
        "description": {
          "type": "string",
          "description": "Human-readable summary of this step, shown in the edit trace."
        },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "createAdjustmentLayer" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["adjustmentType", "layerName", "settings"],
                "additionalProperties": false,
                "properties": {
                  "adjustmentType": {
                    "type": "string",
                    "enum": [
                      "hueSaturation",
                      "curves",
                      "colorBalance",
                      "brightnessContrast",
                      "vibrance",
                      "exposure"
                    ]
                  },
                  "layerName": { "type": "string" },
                  "settings": { "type": "object" },
                  "groupName": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "updateAdjustmentLayer" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["targetLayer", "adjustmentType", "settings"],
                "additionalProperties": false,
                "properties": {
                  "targetLayer": { "type": "string" },
                  "adjustmentType": {
                    "type": "string",
                    "enum": [
                      "hueSaturation",
                      "curves",
                      "colorBalance",
                      "brightnessContrast",
                      "vibrance",
                      "exposure"
                    ]
                  },
                  "settings": { "type": "object" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "renameLayer" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["targetLayer", "newName"],
                "additionalProperties": false,
                "properties": {
                  "targetLayer": { "type": "string" },
                  "newName": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "setLayerOpacity" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["targetLayer", "opacity"],
                "additionalProperties": false,
                "properties": {
                  "targetLayer": { "type": "string" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "createGroup" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["groupName", "layerNames"],
                "additionalProperties": false,
                "properties": {
                  "groupName": { "type": "string" },
                  "layerNames": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "addMask" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["targetLayer", "maskType"],
                "additionalProperties": false,
                "properties": {
                  "targetLayer": { "type": "string" },
                  "maskType": {
                    "type": "string",
                    "enum": [
                      "selectSubject",
                      "selectSky",
                      "full",
                      "invert",
                      "linearGradient",
                      "radialGradient"
                    ]
                  },
                  "feather": { "type": "number", "minimum": 0, "maximum": 250 },
                  "direction": {
                    "type": "string",
                    "enum": ["left", "right", "top", "bottom"],
                    "description": "For linearGradient: which edge the effect is strongest at (fades to none at the opposite edge). Use this for simple horizontal/vertical fades."
                  },
                  "angle": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 360,
                    "description": "For linearGradient: the direction the effect is strongest, in degrees (0=right, 90=bottom, 180=left, 270=top; diagonals: 225=top-left, 315=top-right, 45=bottom-right, 135=bottom-left). Use this instead of 'direction' for diagonal fades. Ignored for radialGradient (a circle is symmetric)."
                  },
                  "region": {
                    "type": "string",
                    "enum": ["center", "edges"],
                    "description": "For radialGradient: whether the effect is strongest in the center (fading outward) or at the edges (a vignette)."
                  },
                  "center": {
                    "type": "array",
                    "items": { "type": "number", "minimum": 0, "maximum": 1 },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "For radialGradient: focal point as [x, y] fractions of the image (0,0 = top-left, 1,1 = bottom-right). Default [0.5, 0.5]. Estimate the subject's position from the preview image."
                  },
                  "size": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 1,
                    "description": "Gradient extent/scale as a fraction of the image. For linearGradient: how far the fade reaches from the effect edge (1 = full width, 0.25 = only the near 25% is affected, untouched beyond). For radialGradient: the radius (larger = bigger area). Default 1 for linear, ~0.5 for radial."
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "For gradient masks: how strong the effect is at its peak (100 = full effect, lower = subtler). Default 100."
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "applyCameraRaw" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["settings"],
                "additionalProperties": false,
                "properties": {
                  "targetLayer": {
                    "type": "string",
                    "description": "Name of the RAW smart-object layer to develop (from the 'RAW smart objects' context). Optional when exactly one RAW layer exists."
                  },
                  "settings": {
                    "type": "object",
                    "description": "The COMPLETE Camera Raw develop state for this photo. Keys use Adobe's crs names. This REPLACES all previous develop settings (including ALL masks) - merge the current settings with your changes; an omitted key resets to camera default.",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "Exposure2012": { "type": "number", "minimum": -5, "maximum": 5, "description": "Exposure in stops." },
                      "Contrast2012": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "Highlights2012": { "type": "integer", "minimum": -100, "maximum": 100, "description": "Negative recovers blown highlights." },
                      "Shadows2012": { "type": "integer", "minimum": -100, "maximum": 100, "description": "Positive lifts shadows." },
                      "Whites2012": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "Blacks2012": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "Texture": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "Clarity2012": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "Dehaze": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "Vibrance": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "Saturation": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "Temperature": { "type": "integer", "minimum": 2000, "maximum": 50000, "description": "White balance in Kelvin (RAW absolute scale; ~5500 = daylight, lower = cooler/bluer, higher = warmer/oranger)." },
                      "Tint": { "type": "integer", "minimum": -150, "maximum": 150, "description": "Green (negative) to magenta (positive)." },
                      "HueAdjustmentRed": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "HueAdjustmentOrange": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "HueAdjustmentYellow": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "HueAdjustmentGreen": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "HueAdjustmentAqua": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "HueAdjustmentBlue": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "HueAdjustmentPurple": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "HueAdjustmentMagenta": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "SaturationAdjustmentRed": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "SaturationAdjustmentOrange": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "SaturationAdjustmentYellow": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "SaturationAdjustmentGreen": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "SaturationAdjustmentAqua": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "SaturationAdjustmentBlue": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "SaturationAdjustmentPurple": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "SaturationAdjustmentMagenta": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "LuminanceAdjustmentRed": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "LuminanceAdjustmentOrange": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "LuminanceAdjustmentYellow": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "LuminanceAdjustmentGreen": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "LuminanceAdjustmentAqua": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "LuminanceAdjustmentBlue": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "LuminanceAdjustmentPurple": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "LuminanceAdjustmentMagenta": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "SplitToningShadowHue": { "type": "integer", "minimum": 0, "maximum": 360 },
                      "SplitToningShadowSaturation": { "type": "integer", "minimum": 0, "maximum": 100 },
                      "SplitToningHighlightHue": { "type": "integer", "minimum": 0, "maximum": 360 },
                      "SplitToningHighlightSaturation": { "type": "integer", "minimum": 0, "maximum": 100 },
                      "SplitToningBalance": { "type": "integer", "minimum": -100, "maximum": 100 },
                      "ColorGradeBlending": { "type": "integer", "minimum": 0, "maximum": 100 },
                      "Sharpness": { "type": "integer", "minimum": 0, "maximum": 150 },
                      "LuminanceSmoothing": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Luminance noise reduction." },
                      "ColorNoiseReduction": { "type": "integer", "minimum": 0, "maximum": 100 },
                      "GrainAmount": { "type": "integer", "minimum": 0, "maximum": 100 },
                      "PostCropVignetteAmount": { "type": "integer", "minimum": -100, "maximum": 100, "description": "Negative darkens corners (classic vignette)." },
                      "MaskGroupBasedCorrections": {
                        "type": "array",
                        "maxItems": 8,
                        "description": "Local adjustments: each correction is a region (one or more masks) plus its own develop values. REPLACES all existing corrections - copy forward any being kept.",
                        "items": {
                          "type": "object",
                          "required": ["CorrectionName"],
                          "additionalProperties": false,
                          "properties": {
                            "CorrectionName": { "type": "string" },
                            "Unsupported": { "type": "boolean", "description": "Marks a manual Camera Raw correction CreaCon preserves verbatim but cannot edit. ALWAYS copy such corrections forward unchanged (name + this flag, nothing else) unless the user explicitly asks to remove that adjustment." },
                            "CorrectionAmount": { "type": "number", "minimum": 0, "maximum": 1, "description": "Overall strength of this correction (default 1)." },
                            "CorrectionActive": { "type": "boolean" },
                            "LocalExposure2012": { "type": "number", "minimum": -1, "maximum": 1, "description": "Local exposure as fraction of full slider (-1..+1)." },
                            "LocalContrast2012": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalHighlights2012": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalShadows2012": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalWhites2012": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalBlacks2012": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalClarity2012": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalDehaze": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalTexture": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalSaturation": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalTemperature": { "type": "number", "minimum": -1, "maximum": 1, "description": "Local warm/cool shift (-1 cool .. +1 warm)." },
                            "LocalTint": { "type": "number", "minimum": -1, "maximum": 1 },
                            "LocalSharpness": { "type": "number", "minimum": -1, "maximum": 1 },
                            "CorrectionMasks": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 4,
                              "items": {
                                "type": "object",
                                "required": ["What"],
                                "additionalProperties": false,
                                "properties": {
                                  "What": { "type": "string", "enum": ["Mask/CircularGradient", "Mask/Gradient"], "description": "Only geometric masks are available. AI/content masks (Mask/Image) and luminance range masks (Mask/RangeMask) are intentionally disabled; compose regions from these shapes, combined via MaskBlendMode (add/intersect) and MaskInverted." },
                                  "MaskName": { "type": "string" },
                                  "MaskInverted": { "type": "boolean" },
                                  "MaskValue": { "type": "number", "minimum": 0, "maximum": 1, "description": "Mask opacity (default 1)." },
                                  "MaskBlendMode": { "type": "integer", "enum": [0, 1], "description": "0 = add to other masks, 1 = intersect." },
                                  "Top": { "type": "number", "minimum": -0.5, "maximum": 1.5, "description": "Mask/CircularGradient: ellipse bounds, normalized." },
                                  "Left": { "type": "number", "minimum": -0.5, "maximum": 1.5 },
                                  "Bottom": { "type": "number", "minimum": -0.5, "maximum": 1.5 },
                                  "Right": { "type": "number", "minimum": -0.5, "maximum": 1.5 },
                                  "Angle": { "type": "number", "minimum": 0, "maximum": 360 },
                                  "Midpoint": { "type": "number", "minimum": 0, "maximum": 100 },
                                  "Feather": { "type": "number", "minimum": 0, "maximum": 100, "description": "Mask/CircularGradient only." },
                                  "Roundness": { "type": "number", "minimum": -100, "maximum": 100, "description": "Mask/CircularGradient only." },
                                  "Flipped": { "type": "boolean", "description": "Mask/CircularGradient: true (default) = effect INSIDE the ellipse; false = effect outside (inverse vignette)." },
                                  "ZeroX": { "type": "number", "minimum": -0.5, "maximum": 1.5, "description": "Mask/Gradient (linear): point where the effect has faded to zero, normalized." },
                                  "ZeroY": { "type": "number", "minimum": -0.5, "maximum": 1.5 },
                                  "FullX": { "type": "number", "minimum": -0.5, "maximum": 1.5, "description": "Mask/Gradient (linear): point where the effect is full strength." },
                                  "FullY": { "type": "number", "minimum": -0.5, "maximum": 1.5 }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "setBlendMode" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["targetLayer", "blendMode"],
                "additionalProperties": false,
                "properties": {
                  "targetLayer": { "type": "string" },
                  "blendMode": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "multiply",
                      "screen",
                      "overlay",
                      "softLight",
                      "hardLight",
                      "colorDodge",
                      "colorBurn",
                      "linearDodge",
                      "linearBurn",
                      "darken",
                      "lighten",
                      "difference",
                      "exclusion",
                      "hue",
                      "saturation",
                      "color",
                      "luminosity"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
