# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for CreaCon.

Built with:  pyinstaller build/creacon.spec --noconfirm

ONE-FOLDER, not one-file. One-file re-extracts the whole bundle to a temp
directory on every launch - slow for 160MB, and antivirus flags the pattern
constantly. One-folder starts instantly and looks like ordinary software.

SPECPATH is set by PyInstaller to this file's directory, so every path below is
relative to the repository and the spec works from any checkout.
"""

import os
from PyInstaller.utils.hooks import collect_data_files, collect_submodules

ROOT = os.path.abspath(os.path.join(SPECPATH, ".."))
BACKEND = os.path.join(ROOT, "backend")

# Imports that live INSIDE function bodies, where PyInstaller's static analysis
# cannot see them. Each one was a real crash before it was listed here.
hiddenimports = [
    "scipy.ndimage",                    # mask_raster.py:45, :83
    "llm_providers.gemini_provider",    # llm_client.py, dispatched at call time
    "llm_providers.anthropic_provider",
]
hiddenimports += collect_submodules("uvicorn")
hiddenimports += collect_submodules("webview")

# scipy ships ~67MB and CreaCon uses exactly three functions from ndimage:
# binary_erosion, binary_dilation and distance_transform_edt. Nothing below is
# on any code path, and dropping them is most of the bundle size.
#
# If a mask ever fails with ModuleNotFoundError pointing at one of these, the
# fix is to delete it from this list - not to add a try/except at the call site.
excludes = [
    "scipy.optimize",
    "scipy.integrate",
    "scipy.interpolate",
    "scipy.stats",
    "scipy.signal",
    "scipy.fft",
    "scipy.fftpack",
    "scipy.io",
    "scipy.cluster",
    "scipy.odr",
    "scipy.constants",
    "tkinter",          # nothing here uses it; PyInstaller pulls it in by habit
    "matplotlib",
    "pytest",
]

datas = collect_data_files("google.genai")
datas += collect_data_files("anthropic")
datas += collect_data_files("webview")          # or the WebView2 DLLs stay behind
datas += [
    (os.path.join(ROOT, "schema", "editPlan.schema.json"), "schema"),
    (os.path.join(BACKEND, "web"), "backend/web"),
    (os.path.join(ROOT, "assets", "creacon.ico"), "assets"),
]

# Generated by build/make_notices.py. Shipping it is not optional: the bundled
# libraries are MIT/BSD/Apache and those licences require their notices to
# travel with any redistribution.
_notices = os.path.join(ROOT, "build", "THIRD-PARTY-NOTICES.txt")
if os.path.exists(_notices):
    datas += [(_notices, ".")]

a = Analysis(
    [os.path.join(BACKEND, "app.py")],
    pathex=[BACKEND],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="CreaCon",
    debug=False,
    strip=False,
    upx=False,
    # console=True while this is still being shaped: a crash before the window
    # opens is otherwise completely silent. Flip to False for release.
    console=True,
    icon=os.path.join(ROOT, "assets", "creacon.ico"),
)

coll = COLLECT(exe, a.binaries, a.datas, strip=False, upx=False, name="CreaCon")
